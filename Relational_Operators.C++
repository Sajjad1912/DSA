#include<bits/stdc++.h>
using namespace std;
int main() {
  cout << (3 < 5) << endl; // Less than operator true = 1, false = 0
  cout << (3 > 5) << endl; // Greater than operator
  cout << (3 <= 5) << endl; // Less than or equal to operator
  cout << (3 >= 5) << endl; // Greater than or equal to operator
  cout << (3 == 5) << endl; // Equal to operator
  cout << (3 != 3) << endl;
  return 0;
}